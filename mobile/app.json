{
  "expo": {
    "name": "Docalio",
    "slug": "docalio",
    "version": "1.0.0",
    "scheme": "docalio",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f5f7fb",
    "ios": {
      "bundleIdentifier": "fr.docalio.app",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "LSSupportsOpeningDocumentsInPlace": false
      }
    },
    "android": {
      "package": "fr.docalio.app",
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "locales": {},
    "plugins": [
      "expo-router",
      "expo-status-bar",
      ["expo-secure-store", { "faceIDPermission": false }],
      "expo-sharing",
      "expo-image",
      ["expo-video", { "supportsBackgroundPlayback": false, "supportsPictureInPicture": false }],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Docalio accède à vos photos pour les ajouter à vos espaces, uniquement quand vous le demandez.",
          "cameraPermission": "Docalio utilise l'appareil photo pour numériser un document ou photographier un chantier et l'ajouter à un espace.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 96,
          "backgroundColor": "#f5f7fb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
